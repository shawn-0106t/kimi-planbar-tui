{
  "name": "kimi-planbar-tui-ts",
  "version": "0.1.2",
  "description": "Terminal-resident Kimi Code plan quota dashboard (TS edition, Bun + OpenTUI)",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "selfcheck:fetch": "bun --use-system-ca run src/main.ts --test-fetch",
    "selfcheck:update": "bun --use-system-ca run src/main.ts --test-update",
    "dev": "bun --use-system-ca run src/main.ts",
    "test": "TZ=Asia/Shanghai bun test",
    "parity": "bun --use-system-ca run test/parity/diff.ts",
    "build:exe": "bun build --compile ./src/main.ts --outfile dist/kpt-tui.exe"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11"
  }
}
